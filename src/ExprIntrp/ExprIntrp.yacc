%code top {
  // This file is part of Open CASCADE Technology software library.
  // This file is generated, do not modify it directly; edit source file ExprIntrp.yacc instead.
}

%language "C++"
%require "3.2"

/* C++ parser interface */
%skeleton "lalr1.cc"

%parse-param  {ExprIntrp::scanner* scanner}

%define parse.error verbose

%token SUMOP MINUSOP DIVIDEOP EXPOP MULTOP PARENTHESIS BRACKET ENDPARENTHESIS ENDBRACKET VALUE IDENTIFIER COMMA DIFFERENTIAL DERIVATE DERIVKEY ASSIGNOP DEASSIGNKEY EQUALOP RELSEPARATOR CONSTKEY SUMKEY PRODKEY
%start exprentry
%left SUMOP MINUSOP
%left DIVIDEOP MULTOP
%left EXPOP

%code requires {
// This file is part of Open CASCADE Technology software library.
// This file is generated, do not modify it directly; edit source file ExprIntrp.yacc instead.

#include "ExprIntrp_yaccintrf.pxx"
#include <Message.hxx>
namespace ExprIntrp
{
  class scanner;
}

#ifdef _MSC_VER
  // disable MSVC warning C4522: 'ExprIntrp::parser::stack_symbol_type': multiple assignment operators
  #pragma warning(disable: 4522)
  // disable MSVC warning C4512: 'ExprIntrp::parser::stack::slice' : assignment operator could not be generated
  #pragma warning(disable: 4512)
#endif

}

%code {
#undef yylex
#define yylex scanner->lex
#define myScanCtx scanner->myCtx

// disable warnings in code generated by bison
#if defined(__clang__)
  #if __has_warning("-Wunused-but-set-variable")
    #pragma clang diagnostic ignored "-Wunused-but-set-variable"
  #endif
#elif defined(_MSC_VER)
  #pragma warning(disable:4065 4244 4131 4127 4702)
  #define YYMALLOC malloc
  #define YYFREE free
#elif defined(__GNUC__) && (__GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 6))
  #pragma GCC diagnostic ignored "-Wunused-but-set-variable"
#endif
}

%code provides {
// Define ExprIntrpFlexLexer class by inclusion of FlexLexer.h,
// but only if this has not been done yet, to avoid redefinition
#if !defined(yyFlexLexer) && !defined(FlexLexerOnce)
  #define yyFlexLexer ExprIntrpFlexLexer
  #include "FlexLexer.h"
#endif

class ExprIntrp_yaccintrf;
namespace ExprIntrp
{
  // Scanner subclass with context.
  class scanner : public ExprIntrpFlexLexer
  {
  public:
    scanner(ExprIntrp_yaccintrf& theCtx, std::istream& theIn);

    int lex(ExprIntrp::parser::semantic_type* yylval);

    ExprIntrp_yaccintrf& myCtx;
  };
}
}

%%

exprentry          : GenExpr
                   | Assignment  
                   | Deassignment
                   | FunctionDefinition  {myScanCtx.ExprIntrp_EndOfFuncDef();}
                   | RelationList {myScanCtx.ExprIntrp_EndOfRelation();}
                   ;

Assignment         : IDENTIFIER {myScanCtx.ExprIntrp_AssignVariable();} ASSIGNOP GenExpr {myScanCtx.ExprIntrp_EndOfAssign();}
                   ;

Deassignment       : DEASSIGNKEY BRACKET IDENTIFIER {myScanCtx.ExprIntrp_Deassign();} ENDBRACKET
                   ;

GenExpr            : GenExpr SUMOP  GenExpr {myScanCtx.ExprIntrp_SumOperator();}
                   | GenExpr MINUSOP GenExpr {myScanCtx.ExprIntrp_MinusOperator();}
                   | GenExpr MULTOP GenExpr {myScanCtx.ExprIntrp_ProductOperator();}
                   | GenExpr DIVIDEOP GenExpr {myScanCtx.ExprIntrp_DivideOperator();}
                   | GenExpr EXPOP GenExpr {myScanCtx.ExprIntrp_ExpOperator();}
                   | PARENTHESIS GenExpr ENDPARENTHESIS
                   | BRACKET GenExpr ENDBRACKET
                   | MINUSOP GenExpr {myScanCtx.ExprIntrp_UnaryMinusOperator();}
                   | SUMOP GenExpr {myScanCtx.ExprIntrp_UnaryPlusOperator();}
                   | SingleExpr
                   | Derivation
                   | ConstantDefinition
                   | Sumator
                   | Productor
                   ;

SingleExpr         : Single
                   | Function
                   ;


Single             : IDENTIFIER  {myScanCtx.ExprIntrp_VariableIdentifier();}
                   | VALUE  {myScanCtx.ExprIntrp_NumValue();}
                   ;

Function           : funcident PARENTHESIS ListGenExpr ENDPARENTHESIS {myScanCtx.ExprIntrp_EndFunction();}
                   | DerFunctionId PARENTHESIS ListGenExpr ENDPARENTHESIS {myScanCtx.ExprIntrp_EndDerFunction();}
                   | DiffFuncId {myScanCtx.ExprIntrp_EndDifferential();} PARENTHESIS ListGenExpr ENDPARENTHESIS {myScanCtx.ExprIntrp_EndDiffFunction();}
                   ;

ListGenExpr        : GenExpr {myScanCtx.ExprIntrp_EndFuncArg();}
                   | GenExpr COMMA {myScanCtx.ExprIntrp_NextFuncArg();} ListGenExpr
                   ;

funcident          : IDENTIFIER  {myScanCtx.ExprIntrp_StartFunction();}
                   ;

FunctionDefinition : FunctionDef {myScanCtx.ExprIntrp_DefineFunction();} ASSIGNOP GenExpr
                   ;

DerFunctionId      : IDENTIFIER {myScanCtx.ExprIntrp_StartDerivate();} DERIVATE {myScanCtx.ExprIntrp_EndDerivate();}
                   ;

DiffFuncId         : DIFFERENTIAL DiffId DIVIDEOP DIFFERENTIAL IDENTIFIER {myScanCtx.ExprIntrp_DiffVar();}
                   | DIFFERENTIAL VALUE {myScanCtx.ExprIntrp_DiffDegree();} DiffId DIVIDEOP DIFFERENTIAL VALUE {myScanCtx.ExprIntrp_VerDiffDegree();} IDENTIFIER {myScanCtx.ExprIntrp_DiffDegreeVar();}
                   ;

DiffId             : IDENTIFIER {myScanCtx.ExprIntrp_StartDifferential();}
                   | DiffFuncId
                   ;

FunctionDef        : IDENTIFIER {myScanCtx.ExprIntrp_StartFunction();} BRACKET ListArg ENDBRACKET
                   ;

ListArg            : unarg {myScanCtx.ExprIntrp_EndFuncArg();}
                   | unarg COMMA {myScanCtx.ExprIntrp_NextFuncArg();} ListArg
                   ;

unarg              : IDENTIFIER {myScanCtx.ExprIntrp_VariableIdentifier();}
                   ;

Derivation         : DERIVKEY BRACKET GenExpr COMMA IDENTIFIER {myScanCtx.ExprIntrp_Derivation();} ENDBRACKET {myScanCtx.ExprIntrp_EndDerivation();}
                   | DERIVKEY BRACKET GenExpr COMMA IDENTIFIER {myScanCtx.ExprIntrp_Derivation();} COMMA VALUE {myScanCtx.ExprIntrp_DerivationValue();} ENDBRACKET {myScanCtx.ExprIntrp_EndDerivation();}
                   ;

ConstantDefinition : CONSTKEY BRACKET IDENTIFIER {myScanCtx.ExprIntrp_ConstantIdentifier();} COMMA VALUE {myScanCtx.ExprIntrp_ConstantDefinition();} ENDBRACKET
                   ;

Sumator            : SUMKEY BRACKET GenExpr COMMA IDENTIFIER {myScanCtx.ExprIntrp_VariableIdentifier();} COMMA GenExpr COMMA GenExpr COMMA VALUE {myScanCtx.ExprIntrp_NumValue();} ENDBRACKET {myScanCtx.ExprIntrp_Sumator();}
                   ;

Productor          : PRODKEY BRACKET GenExpr COMMA IDENTIFIER {myScanCtx.ExprIntrp_VariableIdentifier();} COMMA GenExpr COMMA GenExpr COMMA VALUE {myScanCtx.ExprIntrp_NumValue();} ENDBRACKET {myScanCtx.ExprIntrp_Productor();}
                   ;

RelationList       : SingleRelation 
                   | SingleRelation RELSEPARATOR RelationList
                   | SingleRelation '\n' RelationList
                   ;

SingleRelation     : GenExpr EQUALOP GenExpr {myScanCtx.ExprIntrp_EndOfEqual();}
                   ;

%%

void ExprIntrp::parser::error(const std::string& theMsg)
{
  char aMsg[120] = {};
  const bool isSyntax = strncmp(theMsg.c_str(), "syntax error", 12) == 0;
  if (isSyntax && theMsg.length() > 13)
    Snprintf(aMsg, "Undefined Parsing: Line %d: %s: %s", scanner->lineno() + 1, "Incorrect syntax", theMsg.c_str() + 14);
  else if (isSyntax)
    Snprintf(aMsg, "Undefined Parsing: Line %d: Incorrect syntax", scanner->lineno() + 1);
  else
    Snprintf(aMsg, "Undefined Parsing: Line %d: %s", scanner->lineno() + 1, theMsg.c_str());

  //Message::SendTrace() << aMsg;
  myScanCtx.ExprIntrp_SetLastError(aMsg);
}
