//! Raw color for defining list of standard color.
//! Defined for internal routines (in public for constexpr).
struct Quantity_NamedColorInfo
{
  const char*             StringName = nullptr;
  NCollection_Vec3<float> sRgbValues;
  NCollection_Vec3<float> RgbValues;
  Quantity_NameOfColor    EnumName = Quantity_NOC_BLACK;

  constexpr Quantity_NamedColorInfo(Quantity_NameOfColor theName,
                                    const char* theStringName,
                                    const NCollection_Vec3<float>& thesRGB,
                                    const NCollection_Vec3<float>& theRGB)
  : StringName(theStringName),
    sRgbValues(thesRGB),
    RgbValues(theRGB),
    EnumName(theName) {}

};

// Note that HTML/hex sRGB representation is ignored
#define Quantity_RawColor(theName, theHex, SRGB, sR, sG, sB, RGB, theR, theG, theB) \
  Quantity_NamedColorInfo(Quantity_NOC_##theName, #theName, NCollection_Vec3<float>(sR##f, sG##f, sB##f), NCollection_Vec3<float>(theR##f, theG##f, theB##f))

