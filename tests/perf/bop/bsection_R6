dchrono j start
bsection resab a b
dchrono j stop counter BSectionAB

tscale  c 0 0 0 100
tscale  d 0 0 0 100
dchrono k start
bsection rescd c d
dchrono k stop counter BSectionCD

tscale  e 0 0 0 1000
tscale  f 0 0 0 1000
