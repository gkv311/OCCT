proc makeQuadFace { theRes theVerts } {
  upvar $theRes res
  vertex v1 {*}[lindex $theVerts 0]
  vertex v2 {*}[lindex $theVerts 1]
  vertex v3 {*}[lindex $theVerts 2]
  vertex v4 {*}[lindex $theVerts 3]
  edge e12 v1 v2
  edge e23 v2 v3
  edge e34 v3 v4
  edge e41 v4 v1
  wire w e12 e23 e34 e41
  plane pln 0 0 0  0 0 1
  mkface res pln w
}

