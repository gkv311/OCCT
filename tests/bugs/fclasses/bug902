puts "======="
puts "OCC902: Expr returns bad derivative of math expression with Exp"
puts "======="
puts ""

set test_expr "Exp(5*x)"
set ref_der1  "Exp(5*x)*5"
dexpr "$test_expr"    x=1
dexpr "$test_expr" f' x=1
if { [dexpr "$test_expr" f' -string] != "$ref_der1" } { puts "Error: wrong first derivative" }

v2d
2dzoom 100
2dplot p0 "$test_expr"
2dplot p1 "$test_expr" f' -color RED
xwd ${imagedir}/${casename}.png
