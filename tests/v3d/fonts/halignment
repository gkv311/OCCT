pload MODELING VISUALIZATION
dtracelevel trace
vfont -verbose 1
vfont add [locate_data_file DejaVuSans.ttf] SansFont

proc getMinMax { theShape } {
  uplevel #0 bounding $theShape -save xmin ymin zmin xmax ymax zmax
  set bmin [list [uplevel #0 dval xmin] [uplevel #0 dval ymin] [uplevel #0 dval zmin]]
  set bmax [list [uplevel #0 dval xmax] [uplevel #0 dval ymax] [uplevel #0 dval zmax]]
  return [list $bmin $bmax]
}

top
vertex v1_1   0 0 0
vertex v1_2 100 0 0
edge e1 v1_1 v1_2
text2brep t1 \
 "LEFT BLOCK\n" -font "SansFont" -height 24 -halign LEFT \
 -append "Left line\n"   -halign LEFT \
 -append "Center line\n" -halign CENTER \
 -append "Right line\n"  -halign RIGHT \
 -append "Mixed " -halign LEFT -height 24 -aspect REGULAR \
 -append " XXL " -height 48 \
 -append "italic" -height 24 -aspect ITALIC
donly     t1 e1
bounding  t1
set       t1bnd [getMinMax t1]
fit
xwd ${imagedir}/${casename}_left.png

