puts "================================"
puts "vorishape - command visualizing shape orientation in 3D Viewer"
puts "Test case visualizes entire box"
puts "================================"

pload MODELING VISUALIZATION
box s 100 200 300
vinit View1
vdisplay s -dispMode 1
vfit

voriface s -oriented 0 -mesh 0 -nbAlong 1 -tangents 0
vdump $imagedir/${casename}_facescol.png

voriface s -oriented 1 -mesh 0 -nbAlong 10 -tangents 0
vdump $imagedir/${casename}_facesdir.png

voriface s -oriented 1 -mesh 1 -nbAlong 1 -tangents 0
vdump $imagedir/${casename}_facesdir_mesh.png

voriface s -oriented 1 -mesh 0 -nbAlong 10 -tangents 1
vdump $imagedir/${casename}_facesd1.png

voriface s -oriented 1 -mesh 1 -nbAlong 1 -tangents 1
vdump $imagedir/${casename}_facesd1_mesh.png

voriedge s -oriented 0 -mesh 0 -nbAlong 1 -tangents 0
vdump $imagedir/${casename}_edgescol.png

voriedge s -oriented 1 -mesh 0 -nbAlong 1 -tangents 0
vdump $imagedir/${casename}_edgesdir.png

voriedge s -oriented 1 -mesh 0 -nbAlong 10 -tangents 1
vdump $imagedir/${casename}_edgesd1.png

voriedge s -oriented 1 -mesh 1 -nbAlong 1 -tangents 1
vdump $imagedir/${casename}_edgesd1_mesh.png

vorishape s -oriented 0 -mesh 0 -nbAlong 1 -tangents 0
vdump $imagedir/${casename}_all.png

axo
fit
vori s
xwd $imagedir/${casename}_axo.png
