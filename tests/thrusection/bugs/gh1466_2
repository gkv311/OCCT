# constructs circular wire either as a circle (theN==0) or as a polygon
proc makeCircleWire { theRes theX theY theZ theRadius {theN 0} } {
  upvar $theRes res
  upvar #0 pi pi
  if { $theN == 0 } {
    circle c $theX $theY $theZ $theRadius
    mkedge e c
    wire res e
    return
  }

  set pnts {}
  for { set i 0 } { $i < $theN } { incr i } {
    set anAngle [dval 2.0*pi*$i/$theN]
    lappend pnts [dval $theX+$theRadius*cos($anAngle)] [dval $theY+$theRadius*sin($anAngle)] $theZ
  }
  polyline res -close {*}$pnts
}

