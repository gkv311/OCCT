# Closed polygonal wire on a cylinder of radius theRadius, with theK periods of sinusoidal
# out-of-plane variation of amplitude theAmp around the loop. theK == 1 is secretly planar
# (it is the cylinder's intersection with a tilted plane); theK >= 2 is not.
proc makeSaddleWire {theRes theRadius theK theAmp theZOffset theN} {
  upvar #0 pi pi
  upvar $theRes res
  set aPnts {}
  for {set i 0} {$i < $theN} {incr i} {
    set aTheta [dval 2.0*pi*$i/$theN]
    set aZ     [dval $theAmp*cos($theK*$aTheta)+$theZOffset]
    lappend aPnts [dval $theRadius*cos($aTheta)] [dval $theRadius*sin($aTheta)] $aZ
  }
  puts $aPnts
  polyline res -close {*}$aPnts
}

makeSaddleWire s1 20.0 2 5.0   0.0 60
makeSaddleWire s2 15.0 2 5.0 -10.0 60

