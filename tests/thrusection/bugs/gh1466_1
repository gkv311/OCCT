puts {
========
Modeling - guard CreateSmoothed's fixed-stride shapes array against a section with more edges than section 1

Test case: two matching circle sections should build fine.
========
}

pload MODELING

proc makeCircleWire { theRes theX theY theZ theRadius } {
  upvar $theRes res
  circle c $theX $theY $theZ $theRadius
  mkedge e c
  wire res e
}

makeCircleWire s1 0 0 0  5.0
makeCircleWire s2 0 0 10 3.0

axo
fit
xwd ${imagedir}/${casename}_s.png

dsetsignal unset
thrusections -N result 1 0 s1 s2
