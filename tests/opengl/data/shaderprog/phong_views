puts "========"
puts "Per-pixel lighting using GLSL program (Phong shading)"
puts "========"

pload MODELING VISUALIZATION

# create box
box b 1 2 3

# draw box
vclear
vclose ALL
vinit View1
vsetdispmode 1
vaxo
vdisplay b
vfit
vrotate 0.2 0.0 0.0

set glslVersion ""
if { [string match "OpenGL ES 3*" [vglinfo VERSION]] } { set glslVersion "#version 300 es" }

vshaderprog b phong -header $glslVersion
vdump $::imagedir/${::casename}_v1.png

vinit View2
vfit
vdump $::imagedir/${::casename}_v2.png
vmoveto 250 250
vdump $::imagedir/${::casename}_v2sel.png
vactivate View1
vdump $::imagedir/${::casename}_v1sel.png
vclose View2
